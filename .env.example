# ALIBI runtime configuration. Copy to .env (gitignored). Never commit real keys.
# Safe defaults: offline, zero spend, zero model-backed benchmark runs.

# offline = no network model calls at all (deterministic simulator, checks, scorer,
#           scripted fixture investigator). live = real model through the budget gateway.
RUNTIME_MODE=offline

# Absolute cap on the ESTIMATED cost of every billed model call, across all runs, processes
# and models, at the prices configured below. It is a conservative estimate, not a bill: the
# provider console is the billing authority. Paid overage is never authorized. 0 disables
# every billed route.
LLM_MAX_USD=0
# Automatic calls stop here, beneath the cap (default: LLM_MAX_USD minus 0.50). The remainder
# is a demo reserve that only an explicit operator switch opens: ALIBI_USE_DEMO_RESERVE=1.
LLM_DEV_CEILING_USD=
ALIBI_USE_DEMO_RESERVE=
# The cumulative spend ledger. Absolute path, so every worktree and clone on this machine
# shares one file (default: <repo>/.alibi/spend.json). Never delete or reset it.
ALIBI_SPEND_LEDGER=
# Spend already known from earlier runs. The ledger never reports less than this, so a
# missing ledger file cannot quietly restart the count at zero.
LLM_SPEND_FLOOR_USD=

# One system-run = one investigator configuration on one evidence bundle.
BENCH_MAX_SYSTEM_RUNS=0

# Only read when RUNTIME_MODE=live. local = already-working local tool-calling model
# (cost 0, still capped). included_credits = a billed route paid from an existing balance
# with auto-reload off; requires LLM_MAX_USD>0 and the two price settings below.
# One price pair is configured, so LEAD_MODEL, SUBAGENT_MODEL and ADVERSARY_MODEL must be
# the same model (leave the last two empty to inherit LEAD_MODEL).
LIVE_PROVIDER_KIND=
LEAD_MODEL=
SUBAGENT_MODEL=
ADVERSARY_MODEL=
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
# Local Ollama models only: context window for the agent harness prompt (default 16384).
LLM_NUM_CTX=

# Reasoning effort for models that support it (low|medium|high|xhigh|max) and the per-response output ceiling.
LLM_EFFORT=low
LLM_MAX_TOKENS_PER_CALL=3000

# Per-investigation pilot caps (shared across lead, specialists and retries).
LLM_MAX_CALLS_PER_RUN=16
LLM_MAX_INPUT_TOKENS_PER_RUN=200000
LLM_MAX_OUTPUT_TOKENS_PER_RUN=10000
LLM_MAX_SECONDS_PER_RUN=180
# Largest single request the gateway will send, counted before sending (system prompt, tool
# schemas and messages). Must stay under 95000.
LLM_MAX_INPUT_TOKENS_PER_CALL=40000

# Model provider key (set the one matching your chosen model; server-side only)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# LangSmith tracing (optional until there's a real run to trace)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=hackprinceton

# Local serving (localhost only by default)
ALIBI_HOST=127.0.0.1
ALIBI_PORT=8000
