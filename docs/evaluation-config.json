  "inputs_shared_by_all_systems": [
    "the same frozen bundle bytes",
    "the same neutral tip",
    "the same operational context",
    "the same report schema",
    "the same verifier",
    "the same scorer"
  ],
  "scorable_effect_types": [
    "data_staging",
    "policy_violating_transfer",
    "local_log_removal"
  ],
  "not_scored_as_effects": {
    "login_as": "assessed through account identification and attribution metrics, not recall",
    "failed or partial steps": "counted separately as attempts; never recall targets"
  },
  "matching": {
    "rule": "claim type == effect type AND same host AND (same object OR same session) AND finding window <= max_window_s wide and overlapping the effect window within tolerance_s AND the finding cites at least one record the executed step produced",
    "algorithm": "one-to-one maximum bipartite matching, findings and effects visited in id order",
    "tolerance_s": 120,
    "max_window_s": 1800,
    "only_final_accepted_allegations_can_match": true
  },
  "verifier": {
    "max_allegation_window_s": 1800,
    "window_tolerance_s": 120,
    "note": "applied identically to every system; never adds findings; never reads the answer key"
  },
  "policy": {
    "bulk_threshold_bytes": 5000000
  },
  "b0_rules": [
    {
      "rule": "upload_tool",
      "claim_type": "policy_violating_transfer",
      "pattern": "\\bcurl\\b.*\\s(?:-T|--upload-file)\\s|\\bscp\\s|\\bwget\\s+--post-file|\\bnc\\s+-|\\brsync\\s"
    },
    {
      "rule": "bulk_export",
      "claim_type": "data_staging",
      "pattern": "export_bulk|--dataset\\s"
    },
    {
      "rule": "log_tamper",
      "claim_type": "local_log_removal",
      "pattern": "\\brm\\s+\\S*(?:/var/log|\\.log)|\\bsed\\s+-i\\b.*(?:/var/log|\\.log)|\\btruncate\\s|\\bshred\\s|history\\s+-c|unset\\s+HISTFILE|logrotate\\s+-f"
    }
  ],
  "batch_review": "skipped_for_benchmark (approved_by_human=false); the locked model/baseline output is graded as is",
  "ai_caps_per_investigation": {
    "max_calls": 12,
    "max_input_tokens": 40000,
    "max_output_tokens": 6000,
    "max_seconds": 90.0,
    "tool_result_max_records": 50,
    "tool_result_max_bytes": 8192,
    "shared_across": "lead, specialists and retries"
  },
  "error_policy": "failed and timed-out runs are kept and counted; budget stops are marked censored; no replacement seeds",
  "paid_overage_authorized_usd": 0
}
